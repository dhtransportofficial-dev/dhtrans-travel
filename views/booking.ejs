            <div class="form-row">
              <div class="form-group">
                <label for="passenger_name">Nama Lengkap *</label>
                <input type="text" class="form-control" id="passenger_name" name="passenger_name" placeholder="Masukkan nama lengkap" required>
              </div>
              <div class="form-group">
                <label for="passenger_phone">No. Telepon/WhatsApp *</label>
                <input type="tel" class="form-control" id="passenger_phone" name="passenger_phone" placeholder="08xxxxxxxxxx" required>
              </div>
            </div>

            <div class="form-group">
              <label for="passenger_email">Email (opsional)</label>
              <input type="email" class="form-control" id="passenger_email" name="passenger_email" placeholder="email@contoh.com">
            </div>

            <!-- Penjemputan Section -->
            <div style="background: var(--gray-50); border: 1px solid var(--gray-200); border-radius: var(--radius-md); padding: 1.2rem; margin-bottom: 1.5rem;">
              <div class="form-group" style="margin-bottom: 0.8rem;">
                <label style="font-weight: 700; color: var(--navy-800); display: flex; align-items: center; gap: 6px;">
                  📍 Wilayah Penjemputan (Titik Jemput) *
                </label>
                <div style="display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 6px;">
                  <label class="zone-card-opt selected" onclick="updateZoneStyle('pickup_zone', 'kota')">
                    <input type="radio" name="pickup_zone" value="kota" checked onchange="updateSummary()">
                    <span>🏙️ <strong>Dalam Kota</strong> (Tarif Normal)</span>
                  </label>
                  <label class="zone-card-opt zone-kabupaten" onclick="updateZoneStyle('pickup_zone', 'kabupaten')">
                    <input type="radio" name="pickup_zone" value="kabupaten" onchange="updateSummary()">
                    <span>🏡 <strong>Wilayah Kabupaten</strong> (+Rp20rb/org)</span>
                  </label>
                </div>
              </div>
              <div class="form-group" style="margin-bottom: 0;">
                <label for="pickup_address">Alamat Lengkap Penjemputan *</label>
                <textarea class="form-control" id="pickup_address" name="pickup_address" rows="2" placeholder="Nama jalan, nomor rumah, RT/RW, kelurahan/desa, kecamatan" required></textarea>
                <p class="form-note">Contoh: Jl. Raya Pacet No. 12, Desa Pandan, Kec. Pacet, Kab. Mojokerto</p>
              </div>
            </div>

            <!-- Pengantaran Section -->
            <div style="background: var(--gray-50); border: 1px solid var(--gray-200); border-radius: var(--radius-md); padding: 1.2rem; margin-bottom: 1.5rem;">
              <div class="form-group" style="margin-bottom: 0.8rem;">
                <label style="font-weight: 700; color: var(--navy-800); display: flex; align-items: center; gap: 6px;">
                  🏁 Wilayah Pengantaran (Titik Tujuan) *
                </label>
                <div style="display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 6px;">
                  <label class="zone-card-opt selected" onclick="updateZoneStyle('dropoff_zone', 'kota')">
                    <input type="radio" name="dropoff_zone" value="kota" checked onchange="updateSummary()">
                    <span>🏙️ <strong>Dalam Kota</strong> (Tarif Normal)</span>
                  </label>
                  <label class="zone-card-opt zone-kabupaten" onclick="updateZoneStyle('dropoff_zone', 'kabupaten')">
                    <input type="radio" name="dropoff_zone" value="kabupaten" onchange="updateSummary()">
                    <span>🏡 <strong>Wilayah Kabupaten</strong> (+Rp20rb/org)</span>
                  </label>
                </div>
              </div>
              <div class="form-group" style="margin-bottom: 0;">
                <label for="dropoff_address">Alamat Lengkap Tujuan *</label>
                <textarea class="form-control" id="dropoff_address" name="dropoff_address" rows="2" placeholder="Nama jalan, nomor rumah, RT/RW, kelurahan/desa, kecamatan" required></textarea>
                <p class="form-note">Contoh: Jl. Panji Suroso No. 45, Kec. Kepanjen, Kab. Malang</p>
              </div>
            </div>

            <!-- Metode Pembayaran Section -->
            <div style="background: var(--gray-50); border: 1px solid var(--gray-200); border-radius: var(--radius-md); padding: 1.2rem; margin-bottom: 1.5rem;">
              <label style="font-weight: 700; color: var(--navy-800); display: flex; align-items: center; gap: 6px; margin-bottom: 8px;">
                💳 Pilih Metode Pembayaran *
              </label>
              <div class="payment-selector-grid">
                <label class="payment-card-opt" onclick="updatePaymentMethod('cash')" style="cursor: pointer;">
                  <input type="radio" name="payment_method" value="cash" checked onchange="updateSummary()">
                  <span style="font-size: 1.4rem;">💵</span>
                  <div>
                    <strong style="display: block; color: var(--navy-900);">Bayar di Sopir</strong>
                    <small style="color: var(--gray-600);">Cash saat penjemputan (COD)</small>
                  </div>
                </label>

                <label class="payment-card-opt" onclick="updatePaymentMethod('qris')" style="cursor: pointer;">
                  <input type="radio" name="payment_method" value="qris" onchange="updateSummary()">
                  <span style="font-size: 1.4rem;">📱</span>
                  <div>
                    <strong style="display: block; color: var(--navy-900);">QRIS DH Travel</strong>
                    <small style="color: var(--gray-600);">Scan semua Bank / E-Wallet</small>
                  </div>
                </label>

                <label class="payment-card-opt" onclick="updatePaymentMethod('transfer')" style="cursor: pointer;">
                  <input type="radio" name="payment_method" value="transfer" onchange="updateSummary()">
                  <span style="font-size: 1.4rem;">🏦</span>
                  <div>
                    <strong style="display: block; color: var(--navy-900);">Transfer BCA</strong>
                    <small style="color: var(--gray-600);">No. Rek: 0501199302</small>
                  </div>
                </label>
              </div>
            </div>

            <div class="form-group">
              <label for="notes">Catatan Tambahan (opsional)</label>
              <textarea class="form-control" id="notes" name="notes" rows="2" placeholder="Contoh: Bawa koper besar, patokan depan masjid, butuh kursi tengah, dll."></textarea>
            </div>

            <!-- Form Error Alert Container -->
            <div id="bookingFormError" style="display: none; background: #fee2e2; border: 1.5px solid #f87171; color: #991b1b; padding: 12px 16px; border-radius: var(--radius-md); font-weight: 600; font-size: 0.9rem; margin-bottom: 1rem;"></div>

            <button type="submit" class="btn btn-primary btn-lg btn-full" id="submitBooking" style="font-size: 1.05rem; padding: 14px 20px;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              Konfirmasi Pemesanan
            </button>

            <!-- Quick WhatsApp Alternative Button -->
            <div style="text-align: center; margin-top: 1rem; padding-top: 1rem; border-top: 1px dashed var(--gray-200);">
              <span style="font-size: 0.82rem; color: var(--gray-600); display: block; margin-bottom: 6px;">Mau lebih cepat & tanpa isi form?</span>
              <a href="https://wa.me/6289671969214?text=Halo%20CS%20DH%20Trans,%20saya%20mau%20pesan%20tiket%20travel%20Mojokerto%20-%20Malang." target="_blank" class="btn btn-whatsapp btn-full" style="display: inline-flex; align-items: center; justify-content: center; gap: 8px; font-weight: 700;">
                💬 Pesan Langsung via WhatsApp CS (0896-7196-9214)
              </a>
            </div>
          </form>
        </div>

        <!-- Sidebar Summary -->
        <div class="booking-sidebar">
          <div class="booking-summary">
            <h3>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
              Ringkasan Pesanan
            </h3>
            <div class="summary-row">
              <span class="label">Rute</span>
              <span class="value" id="summaryRoute">-</span>
            </div>
            <div class="summary-row">
              <span class="label">Jam & Via</span>
              <span class="value" id="summaryTimeVia">-</span>
            </div>
            <div class="summary-row">
              <span class="label">Tanggal</span>
              <span class="value" id="summaryDate">-</span>
            </div>
            <div class="summary-row">
              <span class="label">Jumlah Kursi</span>
              <span class="value" id="summaryPassengers">1 orang</span>
            </div>
            <div class="summary-row">
              <span class="label">Metode Bayar</span>
              <span class="value" id="summaryPaymentMethod" style="font-weight: 700; color: #ffffff !important;">💵 Bayar di Sopir</span>
            </div>
            <div class="summary-row">
              <span class="label">Status Kursi</span>
              <span class="value" id="summarySeatAvail" style="color: #2ecc71;">Tersedia</span>
            </div>
            <div class="summary-row">
              <span class="label">Tarif Dasar</span>
              <span class="value" id="summaryBasePrice">Rp0</span>
            </div>
            
            <div class="summary-row" id="pickupSurchargeRow" style="display: none; color: var(--gold-300);">
              <span class="label" style="color: var(--gold-300);">+ Jemput Kab. (+20rb/org)</span>
              <span class="value" id="summaryPickupSurcharge">Rp0</span>
            </div>

            <div class="summary-row" id="dropoffSurchargeRow" style="display: none; color: var(--gold-300);">
              <span class="label" style="color: var(--gold-300);">+ Antar Kab. (+20rb/org)</span>
              <span class="value" id="summaryDropoffSurcharge">Rp0</span>
            </div>

            <div class="summary-total">
              <p class="total-label">Total Pembayaran</p>
              <p class="total-price" id="summaryTotal">Rp0</p>
            </div>
          </div>

          <!-- Driver Contact & CS Cards (Screenshot Style) -->
          <div class="driver-contact-card">
            <h4>
              <span>👨‍✈️</span> Kontak Driver Bertugas
            </h4>
            <div class="driver-list">
              <!-- Driver 1 -->
              <div class="driver-box-card">
                <div class="driver-box-name">Mas Zidan (Driver 1)</div>
                <div class="driver-box-phone">0819-1840-1858</div>
                <a href="https://wa.me/6281918401858?text=Halo%20Mas%20Zidan%20(Driver%201%20DH%20Trans),%20saya%20mau%20tanya%20info%20travel." target="_blank" rel="noopener" class="btn-wa-pill">
                  💬 Chat WA
                </a>
              </div>

              <!-- Driver 2 -->
              <div class="driver-box-card">
                <div class="driver-box-name">Mas Hervin (Driver 2)</div>
                <div class="driver-box-phone">0897-2681-444</div>
                <a href="https://wa.me/628972681444?text=Halo%20Mas%20Hervin%20(Driver%202%20DH%20Trans),%20saya%20mau%20tanya%20info%20travel." target="_blank" rel="noopener" class="btn-wa-pill">
                  💬 Chat WA
                </a>
              </div>

              <!-- CS 24 Jam -->
              <div class="driver-box-card cs-card-box">
                <div class="driver-box-name cs-name">Customer Service (24 Jam)</div>
                <div class="driver-box-phone">0896-7196-9214</div>
                <a href="https://wa.me/6289671969214?text=Halo%20CS%20DH%20Trans,%20saya%20ingin%20tanya%20pemesanan%20tiket." target="_blank" rel="noopener" class="btn-cs-pill">
                  📱 Hubungi CS
                </a>
              </div>
            </div>
          </div>

          <!-- Official Instagram Card (Screenshot Style) -->
          <div class="instagram-card">
            <div class="instagram-card-header">
              <span class="instagram-handle">
                📸 @dhtrans.id
              </span>
              <span class="instagram-badge">OFFICIAL</span>
            </div>
            <p class="instagram-desc">
              Dokumentasi perjalanan, info promo, jadwal terkini & armada DH Trans.
            </p>
            <a href="https://www.instagram.com/dhtrans.id?igsh=MTJkZ3gzcXp5NGkxaQ%3D%3D&utm_source=qr" target="_blank" rel="noopener" class="btn-ig-pill">
              Kunjungi Instagram @dhtrans.id ↗
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Booking Success Modal -->
  <div class="modal-overlay" id="bookingModal">
    <div class="modal-content" style="max-width: 520px;">
      <div class="modal-icon">✅</div>
      <h2>Pemesanan Berhasil!</h2>
      <p style="font-size: 0.88rem; color: var(--gray-600); margin-bottom: 1rem;">Pesanan Anda telah tercatat di sistem DH Trans.</p>
      
      <div class="modal-booking-code" style="margin-bottom: 1rem;">
        <small style="color: #64748b;">Kode Booking Anda:</small><br>
        <span id="modalBookingCode">-</span>
      </div>

      <!-- Dynamic Payment Instructions -->
      <div id="modalPaymentInfo" style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: var(--radius-md); padding: 1rem; margin-bottom: 1.25rem; text-align: left;">
        <!-- Filled by JS -->
      </div>

      <div class="modal-actions">
        <a href="#" id="modalWaLink" class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener">
          💬 Konfirmasi via WhatsApp
        </a>
        <a href="#" id="modalTrackingLink" class="btn btn-secondary" style="background: var(--navy-800); color: white;">
          📍 Lacak Live GPS Perjalanan
        </a>
        <button onclick="document.getElementById('bookingModal').classList.remove('active')" class="btn btn-secondary" style="background: #f1f3f5; color: #495057; border: 1px solid #dee2e6;">
          Tutup
        </button>
      </div>
    </div>
  </div>

  <script>
    const scheduleSelect = document.getElementById('schedule_id');
    const passengerCount = document.getElementById('passenger_count');
    const travelDate = document.getElementById('travel_date');
    const submitBtn = document.getElementById('submitBooking');

    function getSelectedRadioValue(name) {
      const el = document.querySelector('input[name="' + name + '"]:checked');
      return el ? el.value : (name === 'payment_method' ? 'cash' : 'kota');
    }

    async function checkSeatAvailability() {
      const scheduleId = scheduleSelect.value;
      const dateVal = travelDate.value;

      if (!scheduleId || !dateVal) return;

      try {
        const res = await fetch('/api/seats?schedule_id=' + scheduleId + '&travel_date=' + dateVal);
        const data = await res.json();

        const badge = document.getElementById('seatBadge');
        const desc = document.getElementById('seatDesc');
        const summarySeat = document.getElementById('summarySeatAvail');
        const count = parseInt(passengerCount.value || 1);

        if (data.isFull || data.availableSeats <= 0) {
          badge.className = 'status-badge status-cancelled';
          badge.innerHTML = '🔴 FULL BOOKED (KURSI PENUH)';
          desc.textContent = 'Jadwal ini sudah terisi penuh pada tanggal ' + dateVal;
          summarySeat.innerHTML = '<span style="color: #e74c3c; font-weight: bold;">PENUH</span>';
          submitBtn.disabled = true;
          submitBtn.innerHTML = '⛔ Kursi Penuh (Pilih Jadwal Lain)';
        } else if (data.availableSeats < count) {
          badge.className = 'status-badge status-pending';
          badge.innerHTML = '⚠️ Tersisa ' + data.availableSeats + ' Kursi';
          desc.textContent = 'Jumlah penumpang (' + count + ') melebihi sisa kursi (' + data.availableSeats + ')';
          summarySeat.innerHTML = '<span style="color: #e67e22;">Tersisa ' + data.availableSeats + ' Kursi</span>';
          submitBtn.disabled = true;
          submitBtn.innerHTML = '⚠️ Sisa Kursi Tidak Cukup';
        } else {
          badge.className = 'status-badge status-completed';
          badge.innerHTML = '🟢 Tersedia ' + data.availableSeats + ' Kursi';
          desc.textContent = 'Kapasitas maksimal 6 kursi per mobil';
          summarySeat.innerHTML = '<span style="color: #2ecc71;">Tersedia (' + data.availableSeats + ' sisa)</span>';
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg> Konfirmasi Pemesanan';
        }
      } catch (err) {
        console.error('Seat check error:', err);
      }
    }

    function updateSummary() {
      const selected = scheduleSelect.options[scheduleSelect.selectedIndex];
      const count = parseInt(passengerCount.value || 1);
      const pickupZone = getSelectedRadioValue('pickup_zone');
      const dropoffZone = getSelectedRadioValue('dropoff_zone');
      const chosenPay = getSelectedRadioValue('payment_method');

      // Update payment label in summary
      const payMap = {
        'cash': '💵 Bayar di Sopir',
        'qris': '📱 QRIS DH Travel',
        'transfer': '🏦 Transfer BCA'
      };
      const payElem = document.getElementById('summaryPaymentMethod');
      if (payElem) {
        payElem.textContent = payMap[chosenPay] || '💵 Bayar di Sopir';
      }

      if (selected && selected.value) {
        document.getElementById('summaryRoute').textContent = (selected.dataset.origin || 'Mojokerto') + ' → ' + (selected.dataset.destination || 'Malang');
        document.getElementById('summaryTimeVia').textContent = (selected.dataset.time || '06:00') + ' WIB (Via ' + (selected.dataset.via || 'Tol') + ')';
        
        const pricePerPax = parseInt(selected.dataset.price || 150000);
        const baseTotal = pricePerPax * count;
        document.getElementById('summaryBasePrice').textContent = 'Rp' + baseTotal.toLocaleString('id-ID') + ' (' + count + ' org)';
        document.getElementById('summaryPassengers').textContent = count + ' orang';

        const pickupExtra = pickupZone === 'kabupaten' ? 20000 * count : 0;
        const dropoffExtra = dropoffZone === 'kabupaten' ? 20000 * count : 0;

        const pickupRow = document.getElementById('pickupSurchargeRow');
        if (pickupExtra > 0) {
          pickupRow.style.display = 'flex';
          document.getElementById('summaryPickupSurcharge').textContent = '+Rp' + pickupExtra.toLocaleString('id-ID');
        } else {
          pickupRow.style.display = 'none';
        }

        const dropoffRow = document.getElementById('dropoffSurchargeRow');
        if (dropoffExtra > 0) {
          dropoffRow.style.display = 'flex';
          document.getElementById('summaryDropoffSurcharge').textContent = '+Rp' + dropoffExtra.toLocaleString('id-ID');
        } else {
          dropoffRow.style.display = 'none';
        }

        const grandTotal = baseTotal + pickupExtra + dropoffExtra;
        document.getElementById('summaryTotal').textContent = 'Rp' + grandTotal.toLocaleString('id-ID');
      }
      
      const dateVal = travelDate.value;
      if (dateVal) {
        try {
          const parts = dateVal.split('-');
          const d = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
          const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
          document.getElementById('summaryDate').textContent = d.toLocaleDateString('id-ID', options);
        } catch (e) {
          document.getElementById('summaryDate').textContent = dateVal;
        }
      }

      checkSeatAvailability();
    }

    scheduleSelect.addEventListener('change', updateSummary);
