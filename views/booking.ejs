          } else if (paymentMethod === 'transfer') {
            pInfo.innerHTML =
              '<div>' +
              '<div style="display: inline-flex; align-items: center; gap: 6px; background: #0a1628; color: #d4a843; padding: 3px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; margin-bottom: 8px;">' +
