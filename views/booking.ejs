<% var title = 'Pesan Tiket'; %>
<%- include('layout', { body: `

  <div class="page-header">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Beranda</a>
        <span>/</span>
        <span>Pesan Tiket</span>
      </div>
      <h1>Pesan Tiket Travel Reguler</h1>
      <p>Pesan kursi travel door-to-door Mojokerto ⇄ Malang dengan ketersediaan kursi real-time</p>
    </div>
  </div>

  <section class="booking-section">
    <div class="container">
      <!-- Area Coverage Note & Carter Switch -->
      <div style="display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;">
        <div style="flex: 2; min-width: 240px; background: linear-gradient(135deg, rgba(212,168,67,0.15), rgba(10,22,40,0.05)); border: 1px solid rgba(212,168,67,0.4); border-radius: var(--radius-lg); padding: 1rem 1.5rem; display: flex; align-items: center; gap: 1rem;">
          <span style="font-size: 1.8rem;">ℹ️</span>
          <div style="font-size: 0.88rem; color: var(--navy-800);">
            <strong>Jangkauan Wilayah:</strong> Penjemputan / pengantaran dalam kota (Mojokerto Kota & Malang Kota) berlaku tarif standar. Untuk wilayah <strong>Kabupaten Mojokerto / Kabupaten Malang</strong> dikenakan biaya tambahan <strong>+Rp20.000 / orang</strong>.
          </div>
        </div>

        <div style="flex: 1; min-width: 200px; background: linear-gradient(135deg, var(--navy-800), var(--navy-700)); color: white; border-radius: var(--radius-lg); padding: 1rem 1.2rem; display: flex; flex-direction: column; justify-content: center; text-align: center;">
          <div style="font-size: 0.85rem; color: var(--gold-400); font-weight: 600;">Ingin 1 Mobil Khusus / Rombongan?</div>
          <a href="/carter" style="display: inline-block; margin-top: 6px; font-size: 0.82rem; color: white; background: var(--gold-500); padding: 6px 12px; border-radius: var(--radius-full); font-weight: 700;">
            Sewa Carteran Privat →
          </a>
        </div>
      </div>

      <div class="booking-grid">
        <div class="booking-form-card">
          <h2>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            Form Pemesanan Tiket
          </h2>

          <form id="bookingForm">
            <div class="form-row">
              <div class="form-group">
                <label for="travel_date">Tanggal Perjalanan *</label>
                <input type="date" class="form-control" id="travel_date" name="travel_date" required min="${new Date().toISOString().split('T')[0]}" value="${new Date().toISOString().split('T')[0]}">
              </div>
              <div class="form-group">
                <label for="passenger_count">Jumlah Kursi / Penumpang *</label>
                <select class="form-control" id="passenger_count" name="passenger_count" required>
                  <option value="1">1 Orang</option>
                  <option value="2">2 Orang</option>
                  <option value="3">3 Orang</option>
                  <option value="4">4 Orang</option>
                  <option value="5">5 Orang</option>
                  <option value="6">6 Orang (Full Mobil)</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="schedule_id">Pilih Jadwal & Rute Keberangkatan *</label>
              <select class="form-control" id="schedule_id" name="schedule_id" required onchange="updateSummary()">
                ${schedules.map((s, idx) => '<option value="' + s.id + '" data-price="' + s.price + '" data-origin="' + s.origin + '" data-destination="' + s.destination + '" data-time="' + s.departure_time + '" data-via="' + s.via + '" ' + (selectedSchedule ? (selectedSchedule == s.id ? 'selected' : '') : (idx === 0 ? 'selected' : '')) + '>' + s.origin + ' → ' + s.destination + ' | ' + s.departure_time + ' WIB | Via ' + s.via + ' | Rp' + s.price.toLocaleString("id-ID") + '/org</option>').join('')}
