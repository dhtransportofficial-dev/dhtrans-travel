      const activeRadio = document.querySelector('input[name="payment_method"][value="' + val + '"]');
      if (activeRadio) {
        activeRadio.checked = true;
      }
      updateSummary();
    }

    function updateZoneStyle(name, val) {
      const active = document.querySelector('input[name="' + name + '"][value="' + val + '"]');
      if (active) {
        active.checked = true;
      }
      updateSummary();
    }

    // Trigger on load
    document.addEventListener('DOMContentLoaded', updateSummary);
