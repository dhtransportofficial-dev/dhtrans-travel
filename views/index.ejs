<% var title = 'Beranda'; %>
<%- include('layout', { body: `

  <!-- HERO SECTION -->
  <section class="hero" id="hero">
    <div class="hero-shapes">
      <div class="hero-shape"></div>
      <div class="hero-shape"></div>
      <div class="hero-shape"></div>
    </div>
    <div class="hero-bg">
      <img src="/images/hero-hd.jpg" alt="Travel DH Trans">
    </div>
    <div class="container hero-content">
      <div class="hero-inner">
        <div class="hero-text">
          <div class="hero-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
            Setiap Hari Berangkat • On Time • Reguler & Carter
          </div>
          <h1>Travel <span class="highlight">Mojokerto</span> ⇄ <span class="highlight">Malang</span></h1>
          <p class="hero-subtitle">Layanan travel reguler door to door & carter mobil privat dengan armada Toyota All New Veloz (Hitam) & Toyota Calya (Putih). Nyaman, tepat waktu, dan ber-GPS!</p>
          <div class="hero-features">
            <div class="hero-feature">
              <div class="hero-feature-icon">🛡️</div>
              <span>Aman</span>
            </div>
            <div class="hero-feature">
              <div class="hero-feature-icon">✨</div>
              <span>Nyaman</span>
            </div>
            <div class="hero-feature">
              <div class="hero-feature-icon">⏰</div>
              <span>Tepat Waktu</span>
            </div>
            <div class="hero-feature">
              <div class="hero-feature-icon">📍</div>
              <span>Live GPS</span>
            </div>
          </div>
          <div class="hero-actions">
            <a href="/booking" class="btn btn-primary btn-lg">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              Pesan Tiket Reguler
            </a>
            <a href="/carter" class="btn btn-outline btn-lg" style="color: white; border-color: var(--gold-400);">
              🚗 Sewa / Carter Privat
            </a>
          </div>
        </div>
        
        <div class="hero-card">
          <h3>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Booking Cepat
          </h3>
          <form id="quickBookingForm" onsubmit="return false;">
            <div class="form-group dark">
              <label>Pilih Rute & Jadwal</label>
              <select class="form-control dark" id="quickRoute">
                ${schedules.map(s => '<option value="' + s.id + '">' + s.origin + ' → ' + s.destination + ' (' + s.departure_time + ' WIB - ' + s.via + ')</option>').join('')}
              </select>
            </div>
            <div class="form-group dark">
              <label>Tanggal Perjalanan</label>
              <input type="date" class="form-control dark" id="quickDate" min="${new Date().toISOString().split('T')[0]}" value="${new Date().toISOString().split('T')[0]}">
            </div>
            <div class="form-group dark">
              <label>Jumlah Kursi</label>
              <select class="form-control dark" id="quickPassengers">
                <option value="1">1 Orang</option>
                <option value="2">2 Orang</option>
                <option value="3">3 Orang</option>
                <option value="4">4 Orang</option>
                <option value="5">5 Orang</option>
                <option value="6">6 Orang</option>
              </select>
            </div>
            <button class="btn btn-primary btn-full" onclick="redirectToBooking()" id="quickBookBtn" type="button">
              Cek Ketersediaan Kursi →
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- CARTER & GPS PROMO SECTION -->
  <section class="section" style="background: var(--navy-900); color: white; padding: 2.5rem 0;">
    <div class="container">
      <div class="promo-grid">
        <!-- Carter Promo Card -->
        <div style="background: linear-gradient(135deg, rgba(212,168,67,0.15), rgba(255,255,255,0.03)); border: 2px solid var(--gold-500); border-radius: var(--radius-lg); padding: 2rem; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: inline-flex; align-items: center; gap: 8px; background: var(--gold-500); color: var(--navy-900); padding: 4px 12px; border-radius: var(--radius-full); font-size: 0.8rem; font-weight: 700; margin-bottom: 1rem;">
              🚗 LAYANAN KHUSUS
            </div>
            <h3 style="font-size: 1.5rem; color: white; margin-bottom: 0.8rem;">Sewa / Carter Mobil Privat</h3>
            <p style="color: rgba(255,255,255,0.8); font-size: 0.92rem; line-height: 1.6; margin-bottom: 1.2rem;">
              Butuh 1 mobil full untuk keluarga, drop bandara, wisata Batu/Bromo, atau dinas kantor? Kami sediakan layanan carter privat fleksibel. <strong>Harga ditentukan langsung oleh admin berdasarkan jarak & durasi waktu perjalanan Anda!</strong>
            </p>
            <ul style="color: rgba(255,255,255,0.85); font-size: 0.88rem; list-style: none; padding: 0; display: flex; flex-direction: column; gap: 6px; margin-bottom: 1.5rem;">
              <li>✔ Armada Toyota Veloz (Hitam) & Toyota Calya (Putih)</li>
              <li>✔ Bebas tentukan jam & titik penjemputan</li>
              <li>✔ Penawaran harga transparan & bersahabat</li>
            </ul>
          </div>
          <a href="/carter" class="btn btn-primary btn-lg">
            Ajukan Permintaan Carteran →
          </a>
        </div>

        <!-- Live GPS Promo Card -->
        <div style="background: linear-gradient(135deg, var(--navy-800), var(--navy-700)); border: 1px solid rgba(255,255,255,0.1); border-radius: var(--radius-lg); padding: 2rem; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: inline-flex; align-items: center; gap: 8px; background: #2ecc71; color: white; padding: 4px 12px; border-radius: var(--radius-full); font-size: 0.8rem; font-weight: 700; margin-bottom: 1rem;">
              🛰️ FITUR UNGGULAN
            </div>
            <h3 style="font-size: 1.5rem; color: white; margin-bottom: 0.8rem;">Live GPS Tracking Perjalanan</h3>
            <p style="color: rgba(255,255,255,0.8); font-size: 0.92rem; line-height: 1.6; margin-bottom: 1.2rem;">
              Pantau pergerakan armada travel secara langsung di peta interaktif dari penjemputan hingga tiba di kota tujuan dengan estimasi waktu (ETA) akurat dan kontak langsung ke driver!
            </p>
            <div style="background: rgba(0,0,0,0.25); border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 1.5rem; font-size: 0.85rem;">
              <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
                <span style="color: var(--gold-400);">👨‍✈️ Driver 1 (Zidan):</span>
                <strong>0819-1840-1858</strong>
              </div>
              <div style="display: flex; justify-content: space-between;">
                <span style="color: var(--gold-400);">👨‍✈️ Driver 2 (Hervin):</span>
                <strong>0897-2681-444</strong>
              </div>
            </div>
          </div>
          <a href="/tracking" class="btn btn-outline btn-lg" style="color: white; border-color: #2ecc71;">
            📍 Buka Peta Live GPS Tracking →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES SECTION -->
  <section class="section" id="features">
    <div class="container">
      <div class="section-header">
        <h2>Mengapa Pilih DH Trans?</h2>
        <p>Kami berkomitmen memberikan layanan travel terbaik untuk perjalanan Anda</p>
      </div>
      <div class="features-grid">
        <div class="feature-card animate-on-scroll stagger-1">
          <div class="feature-icon">🛡️</div>
          <h3>Aman & Terpercaya</h3>
          <p>Armada rutin diservis, driver handal hafal medan Mojokerto & Malang via Tol maupun Jalur Pandaan.</p>
        </div>
        <div class="feature-card animate-on-scroll stagger-2">
          <div class="feature-icon">✨</div>
          <h3>Armada Modern</h3>
          <p>Toyota All New Veloz (Hitam) & Toyota Calya (Putih). Interior wangi, full AC, dan jok empuk.</p>
        </div>
        <div class="feature-card animate-on-scroll stagger-3">
          <div class="feature-icon">⏰</div>
          <h3>Tepat Waktu (On-Time)</h3>
          <p>Jadwal pasti pagi & sore setiap hari. Tidak perlu khawatir terlambat urusan dinas / kuliah.</p>
        </div>
        <div class="feature-card animate-on-scroll stagger-4">
          <div class="feature-icon">🏠</div>
          <h3>Door to Door Service</h3>
          <p>Dijemput di depan pintu rumah dan diantar sampai alamat tujuan di Mojokerto maupun Malang.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SCHEDULE SECTION -->
  <section class="section section-gradient" id="schedule">
    <div class="container">
      <div class="section-header">
        <h2>Jadwal & Tarif Reguler</h2>
        <p>Berangkat setiap hari • Kapasitas maksimal 6 kursi per mobil</p>
      </div>
      <div class="schedule-grid">
        <!-- Mojokerto -> Malang -->
        <div class="schedule-card animate-on-scroll">
          <div class="schedule-card-header">
            <div class="route-icon">📍</div>
            <div>
              <h3>Mojokerto <span class="route-arrow">→</span> Malang</h3>
              <p style="font-size: 0.75rem; color: rgba(255,255,255,0.7); margin-top: 2px;">Berangkat setiap hari • Door to Door</p>
            </div>
          </div>
          <div class="schedule-list">
            ${schedules.filter(s => s.origin === 'Mojokerto').map(s => `
              <div class="schedule-item-card">
                <div class="schedule-info-left">
                  <div class="schedule-time">
                    <span>⏰</span> <strong>${s.departure_time} WIB</strong>
                  </div>
                  <span class="schedule-via-tag">Via ${s.via}</span>
                </div>
                <div class="schedule-info-right">
                  <div class="schedule-price">
                    <strong>Rp${s.price.toLocaleString("id-ID")}</strong>
                    <small>/orang</small>
                  </div>
                  <a href="/booking?schedule=${s.id}" class="btn-book-ticket">
                    Pesan Tiket →
                  </a>
                </div>
              </div>
            `).join('')}
          </div>
        </div>

        <!-- Malang -> Mojokerto -->
        <div class="schedule-card animate-on-scroll">
          <div class="schedule-card-header">
            <div class="route-icon">📍</div>
            <div>
              <h3>Malang <span class="route-arrow">→</span> Mojokerto</h3>
              <p style="font-size: 0.75rem; color: rgba(255,255,255,0.7); margin-top: 2px;">Berangkat setiap hari • Door to Door</p>
            </div>
          </div>
          <div class="schedule-list">
            ${schedules.filter(s => s.origin === 'Malang').map(s => `
              <div class="schedule-item-card">
                <div class="schedule-info-left">
                  <div class="schedule-time">
                    <span>⏰</span> <strong>${s.departure_time} WIB</strong>
                  </div>
                  <span class="schedule-via-tag">Via ${s.via}</span>
                </div>
                <div class="schedule-info-right">
                  <div class="schedule-price">
                    <strong>Rp${s.price.toLocaleString("id-ID")}</strong>
                    <small>/orang</small>
                  </div>
                  <a href="/booking?schedule=${s.id}" class="btn-book-ticket">
                    Pesan Tiket →
                  </a>
                </div>
              </div>
            `).join('')}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS SECTION -->
  <section class="section section-dark" id="testimonials">
    <div class="container">
      <div class="section-header">
        <h2>Apa Kata Pelanggan?</h2>
        <p>Pengalaman nyata pelanggan travel & carteran DH Trans</p>
      </div>
      <div class="testimonials-grid">
        ${testimonials.map((t, i) => '<div class="testimonial-card animate-on-scroll stagger-' + (i % 4 + 1) + '"><div class="testimonial-stars">' + Array(t.rating).fill('<svg width="18" height="18" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>').join('') + '</div><p class="testimonial-text">' + t.comment + '</p><div class="testimonial-author"><div class="testimonial-avatar">' + t.name.charAt(0) + '</div><div class="testimonial-author-info"><h4>' + t.name + '</h4><p>' + (t.route_text || '') + '</p></div></div></div>').join('')}
      </div>
    </div>
  </section>

  <!-- CTA SECTION -->
  <section class="cta-section">
    <div class="container cta-content">
      <h2>Siap Berangkat Bersama DH Trans?</h2>
      <p>Pesan tiket travel atau carter mobil sekarang. Layanan cepat dan responsif 24 jam!</p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/booking" class="btn btn-primary btn-lg">📋 Pesan Tiket Online</a>
        <a href="/carter" class="btn btn-outline btn-lg" style="color: white; border-color: var(--gold-400);">🚗 Sewa Carteran</a>
        <a href="https://wa.me/6289671969214?text=Halo%20DH%20Trans!%20Saya%20ingin%20tanya%20layanan%20travel." class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener">💬 WhatsApp CS</a>
      </div>
    </div>
  </section>

  <script>
    function redirectToBooking() {
      const scheduleId = document.getElementById('quickRoute').value;
      const dateVal = document.getElementById('quickDate').value;
      window.location.href = '/booking?schedule=' + scheduleId;
    }
  </script>

` }) %>
