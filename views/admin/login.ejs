<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login Admin - DH Trans</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/png" href="/images/logo-icon.png">
</head>
<body>
  <div class="admin-login-page">
    <div class="admin-login-card animate-on-scroll visible">
      <div class="logo-area">
        <div class="logo-text" style="font-size: 2rem; color: #fff; font-family: var(--font-primary); font-weight: 800; font-style: italic;">
          DH <span style="color: var(--gold-500); font-style: normal; font-size: 0.85em;">TRANS</span>
        </div>
        <h2>Panel Administrator</h2>
        <p>Masuk untuk mengelola sistem travel</p>
      </div>

      <% if (error) { %>
        <div class="error-message">⚠️ <%= error %></div>
      <% } %>

      <form method="POST" action="/admin/login">
        <div class="form-group dark" style="text-align: left;">
          <label>Username</label>
          <input type="text" class="form-control dark" name="username" placeholder="Masukkan username" required autofocus value="admin">
        </div>
        <div class="form-group dark" style="text-align: left;">
          <label>Password</label>
          <input type="password" class="form-control dark" name="password" placeholder="Masukkan password" required value="admin123">
        </div>
        <button type="submit" class="btn btn-primary btn-full btn-lg" style="margin-top: 1rem;">
          Masuk ke Dashboard →
        </button>
      </form>

      <div style="margin-top: 1.5rem; font-size: 0.8rem; color: rgba(255,255,255,0.4);">
        Default Admin: <strong>admin</strong> | Password: <strong>admin123</strong>
      </div>
      <div style="margin-top: 1rem;">
        <a href="/" style="color: var(--gold-500); font-size: 0.85rem;">← Kembali ke Website</a>
      </div>
    </div>
  </div>
</body>
</html>
