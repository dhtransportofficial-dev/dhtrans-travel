<% var title = 'Dashboard Admin'; var pageTitle = 'Dashboard Overview'; %>
<%- include('layout', { body: `

  <!-- Stats Grid -->
  <div class="stats-grid">
    <div class="stat-card gold">
      <div class="stat-icon gold">💰</div>
      <div class="stat-value">Rp${(stats.totalRevenue || 0).toLocaleString('id-ID')}</div>
      <div class="stat-label">Total Pendapatan Terkonfirmasi</div>
    </div>
    <div class="stat-card navy">
      <div class="stat-icon navy">📋</div>
      <div class="stat-value">${stats.totalBookings || 0}</div>
      <div class="stat-label">Total Semua Booking</div>
    </div>
    <div class="stat-card blue">
      <div class="stat-icon blue">⏳</div>
      <div class="stat-value">${stats.pendingBookings || 0}</div>
      <div class="stat-label">Menunggu Konfirmasi</div>
    </div>
    <div class="stat-card green">
      <div class="stat-icon green">✅</div>
      <div class="stat-value">${stats.confirmedBookings || 0}</div>
      <div class="stat-label">Booking Terkonfirmasi</div>
    </div>
  </div>

  <!-- Quick Actions & Alerts -->
  <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
    <!-- Banner -->
    <div class="card" style="background: linear-gradient(135deg, var(--navy-800), var(--navy-700)); color: white; padding: 2rem;">
      <h2 style="font-size: 1.4rem; margin-bottom: 0.5rem; color: white;">Selamat Datang di Admin Panel DH Trans!</h2>
      <p style="color: rgba(255,255,255,0.7); font-size: 0.95rem; margin-bottom: 1.5rem; line-height: 1.6;">
        Kelola jadwal perjalanan, verifikasi booking dari pelanggan, dan atur layanan travel Mojokerto ⇄ Malang dengan mudah.
      </p>
      <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <a href="/admin/bookings" class="btn btn-primary btn-sm">Kelola Pemesanan →</a>
        <a href="/admin/schedules" class="btn btn-secondary btn-sm">Atur Jadwal & Harga</a>
      </div>
    </div>

    <!-- Quick info card -->
    <div class="card" style="padding: 1.5rem;">
      <h3 style="font-size: 1.1rem; color: var(--navy-800); margin-bottom: 1rem;">Ringkasan Notifikasi</h3>
      <div style="display: flex; flex-direction: column; gap: 0.8rem;">
        <a href="/admin/bookings?status=pending" style="display: flex; justify-content: space-between; align-items: center; padding: 10px; background: var(--gray-50); border-radius: var(--radius-md);">
          <span style="font-size: 0.9rem; color: var(--gray-700);">Booking Pending</span>
          <span class="status-badge status-pending">${stats.pendingBookings || 0}</span>
        </a>
        <a href="/admin/contacts" style="display: flex; justify-content: space-between; align-items: center; padding: 10px; background: var(--gray-50); border-radius: var(--radius-md);">
          <span style="font-size: 0.9rem; color: var(--gray-700);">Pesan Belum Dibaca</span>
          <span class="status-badge" style="background: var(--info-bg); color: #0c5460;">${stats.unreadContacts || 0}</span>
        </a>
        <a href="/admin/testimonials" style="display: flex; justify-content: space-between; align-items: center; padding: 10px; background: var(--gray-50); border-radius: var(--radius-md);">
          <span style="font-size: 0.9rem; color: var(--gray-700);">Total Testimoni</span>
          <span class="status-badge status-completed">4</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Live Drivers GPS Status Panel -->
  <div class="card animate-on-scroll" style="padding: 1.5rem; border-radius: var(--radius-lg); margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 8px;">
      <div>
        <h3 style="font-size: 1.15rem; color: var(--navy-900); margin: 0;">🛰️ Status GPS Armada & Sopir Bertugas</h3>
        <p style="font-size: 0.78rem; color: var(--gray-600); margin: 2px 0 0;">Sopir mengaktifkan/menonaktifkan GPS dari HP mereka via portal link di bawah</p>
      </div>
      <a href="/tracking" target="_blank" class="btn btn-sm btn-primary" style="font-size: 0.78rem;">📍 Buka Peta Pelanggan ↗</a>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem;">
      ${drivers.map(d => `
        <div style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 10px; padding: 1rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
            <strong style="color: var(--navy-900); font-size: 0.95rem;">${d.name}</strong>
            <span style="padding: 2px 8px; border-radius: 20px; font-size: 0.72rem; font-weight: 800; background: ${d.is_tracking_active ? '#dcfce7; color: #166534;' : '#fee2e2; color: #991b1b;'}">
              ${d.is_tracking_active ? '🟢 GPS ONLINE' : '🔴 GPS OFFLINE'}
            </span>
          </div>
          <div style="font-size: 0.8rem; color: var(--gray-700); margin-bottom: 4px;">🚗 ${d.car} • <span style="font-family: monospace; font-weight: 700; color: var(--gold-600);">${d.plate}</span></div>
          <div style="font-size: 0.76rem; color: var(--gray-500); margin-bottom: 10px;">📱 ${d.phone} • Speed: ${d.speed || 0} km/jam</div>
          <div style="display: flex; gap: 6px; flex-wrap: wrap;">
            <a href="/driver?id=${d.id}" target="_blank" class="btn btn-sm" style="background: var(--navy-800); color: white; font-size: 0.72rem; padding: 5px 10px;">
              📱 Buka Portal HP Driver
            </a>
            <a href="https://wa.me/62${d.phone.replace(/^0/, '').replace(/[^0-9]/g, '')}?text=${encodeURIComponent('Halo ' + d.name.split(' ')[0] + ', mohon aktifkan GPS di HP saat mulai penjemputan: http://localhost:3000/driver?id=' + d.id)}" target="_blank" class="btn btn-sm btn-whatsapp" style="font-size: 0.72rem; padding: 5px 10px;">
              💬 WA Sopir
            </a>
          </div>
        </div>
      `).join('')}
    </div>
  </div>

` }) %>
