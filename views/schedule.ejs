<% var title = 'Jadwal & Harga'; %>
<%- include('layout', { body: `

  <div class="page-header">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Beranda</a>
        <span>/</span>
        <span>Jadwal & Harga</span>
      </div>
      <h1>Jadwal & Harga</h1>
      <p>Jadwal keberangkatan harian dan daftar harga travel DH Trans</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <!-- Info Banner -->
      <div style="background: linear-gradient(135deg, var(--gold-500), var(--gold-400)); border-radius: var(--radius-lg); padding: 1.25rem 1.5rem; margin-bottom: 2rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
        <span style="font-size: 2rem;">🚐</span>
        <div>
          <h3 style="color: var(--navy-900); font-size: 1.05rem; margin: 0;">Setiap Hari Berangkat! (Mojokerto ⇄ Malang)</h3>
          <p style="color: rgba(10,22,40,0.8); font-size: 0.82rem; margin: 2px 0 0;">Layanan Door-to-Door • On Time • Bayar di Sopir / QRIS / Transfer Bank</p>
        </div>
        <a href="/booking" class="btn" style="margin-left: auto; background: var(--navy-900); color: white; padding: 8px 16px; font-weight: 700;">Pesan Tiket Online →</a>
      </div>

      <!-- Structured Comparison Table Section -->
      <div class="card animate-on-scroll" style="padding: 1.25rem; border-radius: var(--radius-lg); margin-bottom: 2.5rem; box-shadow: var(--shadow-sm); border: 1px solid var(--gray-200);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.85rem; flex-wrap: wrap; gap: 6px;">
          <div>
            <h2 style="font-size: 1.15rem; color: var(--navy-900); margin: 0;">📋 Tabel Rute, Jadwal & Tarif Resmi</h2>
            <p style="font-size: 0.78rem; color: var(--gray-600); margin: 2px 0 0;">Daftar lengkap tarif per orang door-to-door (dijemput & diantar sampai alamat)</p>
          </div>
          <span class="status-badge status-completed" style="font-size: 0.72rem;">🟢 Buka Setiap Hari</span>
        </div>

        <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
          <table class="schedule-table-modern" style="margin-top: 0;">
            <thead>
              <tr>
                <th>Rute Perjalanan</th>
                <th>Jam Berangkat</th>
                <th>Jalur / Via</th>
                <th>Armada Mobil</th>
                <th>Tarif / Orang</th>
                <th>Metode Bayar</th>
                <th>Pemesanan</th>
              </tr>
            </thead>
            <tbody>
              ${schedules.map(s => `
                <tr>
                  <td>
                    <strong style="color: var(--navy-900); font-size: 0.9rem;">${s.origin} → ${s.destination}</strong>
                    <div style="font-size: 0.72rem; color: var(--gray-500);">Door to Door</div>
                  </td>
                  <td>
                    <strong style="color: var(--navy-900); font-size: 0.95rem; font-family: monospace;">⏰ ${s.departure_time} WIB</strong>
                  </td>
                  <td>
                    <span class="schedule-via-tag ${s.via.toLowerCase().includes('tol') ? 'tag-tol' : 'tag-pandaan'}" style="font-size: 0.72rem; padding: 3px 8px;">Via ${s.via}</span>
                  </td>
                  <td style="font-size: 0.8rem; color: var(--navy-800);">
                    🚗 All New Veloz / Calya
                  </td>
                  <td>
                    <strong style="color: var(--gold-600); font-size: 1rem;">Rp${s.price.toLocaleString("id-ID")}</strong>
                    <small style="color: var(--gray-500); display: block; font-size: 0.68rem;">/kursi/orang</small>
                  </td>
                  <td>
                    <div style="font-size: 0.75rem; color: var(--gray-700); line-height: 1.4;">
                      💵 Bayar di Sopir<br>
                      📱 QRIS / Bank
                    </div>
                  </td>
                  <td>
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                      <a href="/booking?schedule=${s.id}" class="btn btn-sm btn-primary" style="padding: 4px 10px; font-size: 0.72rem; text-align: center;">
                        🎫 Pesan Tiket
                      </a>
                      <a href="https://wa.me/6289671969214?text=${encodeURIComponent('Halo DH Trans! Saya mau tanya jadwal ' + s.origin + ' ke ' + s.destination + ' jam ' + s.departure_time + ' WIB (Via ' + s.via + ').')}" target="_blank" class="btn btn-sm btn-whatsapp" style="padding: 4px 10px; font-size: 0.72rem; text-align: center;">
                        💬 Chat WA
                      </a>
                    </div>
                  </td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      </div>

      <div class="schedule-grid">
        <!-- Mojokerto -> Malang -->
        <div class="schedule-card schedule-card-navy animate-on-scroll">
          <div class="schedule-card-header schedule-header-navy">
            <div class="route-icon route-icon-gold">📍</div>
            <div>
              <h3>Mojokerto <span class="route-arrow">→</span> Malang</h3>
              <p style="font-size: 0.75rem; color: rgba(255,255,255,0.8); margin-top: 2px;">Berangkat Setiap Hari • Door to Door</p>
            </div>
          </div>
          <div class="schedule-list">
            ${schedules.filter(s => s.origin === 'Mojokerto').map(s => `
              <div class="schedule-box-card">
                <div class="schedule-box-title">⏰ Jam ${s.departure_time} WIB</div>
                <div class="schedule-box-sub">
                  <span class="schedule-via-tag ${s.via.toLowerCase().includes('tol') ? 'tag-tol' : 'tag-pandaan'}">Via ${s.via}</span>
                  <span class="schedule-box-price">Rp${s.price.toLocaleString("id-ID")} <small>/orang</small></span>
                </div>
                <a href="https://wa.me/6289671969214?text=${encodeURIComponent('Halo DH Trans! Saya mau pesan tiket travel Mojokerto ke Malang jam ' + s.departure_time + ' WIB (Via ' + s.via + '). Apakah kursi masih tersedia?')}" target="_blank" rel="noopener" class="btn-wa-pill">
                  💬 Chat WA Pesan Tiket
                </a>
              </div>
            `).join('')}
          </div>
        </div>

        <!-- Malang -> Mojokerto -->
        <div class="schedule-card schedule-card-teal animate-on-scroll">
          <div class="schedule-card-header schedule-header-teal">
            <div class="route-icon route-icon-teal">📍</div>
            <div>
              <h3>Malang <span class="route-arrow">→</span> Mojokerto</h3>
              <p style="font-size: 0.75rem; color: rgba(255,255,255,0.8); margin-top: 2px;">Berangkat Setiap Hari • Door to Door</p>
            </div>
          </div>
          <div class="schedule-list">
            ${schedules.filter(s => s.origin === 'Malang').map(s => `
              <div class="schedule-box-card">
                <div class="schedule-box-title">⏰ Jam ${s.departure_time} WIB</div>
                <div class="schedule-box-sub">
                  <span class="schedule-via-tag ${s.via.toLowerCase().includes('tol') ? 'tag-tol' : 'tag-pandaan'}">Via ${s.via}</span>
                  <span class="schedule-box-price">Rp${s.price.toLocaleString("id-ID")} <small>/orang</small></span>
                </div>
                <a href="https://wa.me/6289671969214?text=${encodeURIComponent('Halo DH Trans! Saya mau pesan tiket travel Malang ke Mojokerto jam ' + s.departure_time + ' WIB (Via ' + s.via + '). Apakah kursi masih tersedia?')}" target="_blank" rel="noopener" class="btn-wa-pill">
                  💬 Chat WA Pesan Tiket
                </a>
              </div>
            `).join('')}
          </div>
        </div>
      </div>

      <!-- Additional Info -->
      <div style="margin-top: 3rem; display: flex; flex-wrap: wrap; gap: 1rem;" class="animate-on-scroll">
        <div class="card" style="flex: 1; min-width: 140px; border-top: 4px solid var(--gold-500);">
          <div class="card-body" style="text-align: center; padding: 1rem;">
            <span style="font-size: 1.8rem;">🏠</span>
            <h3 style="font-size: 0.85rem; margin: 0.5rem 0; color: var(--navy-800);">Door to Door</h3>
            <p style="font-size: 0.75rem; color: var(--gray-600);">Dijemput & diantar sampai tujuan</p>
          </div>
        </div>
        <div class="card" style="flex: 1; min-width: 140px; border-top: 4px solid var(--gold-500);">
          <div class="card-body" style="text-align: center; padding: 1rem;">
            <span style="font-size: 1.8rem;">📍</span>
            <h3 style="font-size: 0.85rem; margin: 0.5rem 0; color: var(--navy-800);">Wilayah Kabupaten</h3>
            <p style="font-size: 0.75rem; color: var(--gray-600);">Kab. Mojokerto / Kab. Malang +Rp20rb/org</p>
          </div>
        </div>
        <div class="card" style="flex: 1; min-width: 140px; border-top: 4px solid var(--gold-500);">
          <div class="card-body" style="text-align: center; padding: 1rem;">
            <span style="font-size: 1.8rem;">💳</span>
            <h3 style="font-size: 0.85rem; margin: 0.5rem 0; color: var(--navy-800);">Bayar di Tempat</h3>
            <p style="font-size: 0.75rem; color: var(--gray-600);">Pembayaran saat keberangkatan</p>
          </div>
        </div>
        <div class="card" style="flex: 1; min-width: 140px; border-top: 4px solid var(--gold-500);">
          <div class="card-body" style="text-align: center; padding: 1rem;">
            <span style="font-size: 1.8rem;">📱</span>
            <h3 style="font-size: 0.85rem; margin: 0.5rem 0; color: var(--navy-800);">Booking Cepat</h3>
            <p style="font-size: 0.75rem; color: var(--gray-600);">Pesan via web atau WhatsApp 24 Jam</p>
          </div>
        </div>
      </div>
    </div>
  </section>

` }) %>
