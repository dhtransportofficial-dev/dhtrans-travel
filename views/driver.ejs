<% var title = 'Driver Portal GPS'; %>
<%- include('layout', { body: `

  <div class="page-header" style="background: linear-gradient(135deg, var(--navy-950), #064e3b);">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Beranda</a>
        <span>/</span>
        <span>Driver Portal</span>
      </div>
      <h1>👨‍✈️ Driver GPS Portal (HP Sopir)</h1>
      <p>Aktifkan pelacakan GPS di HP Anda saat mulai bergerak menjemput / mengantar penumpang</p>
    </div>
  </div>

  <section class="section">
    <div class="container" style="max-width: 650px;">
      
      <!-- Driver Selection & Status Card -->
      <div class="card" style="padding: 1.5rem; border-radius: var(--radius-lg); border-top: 5px solid var(--gold-500); margin-bottom: 1.5rem; box-shadow: var(--shadow-md);">
        
        <div style="margin-bottom: 1.25rem;">
          <label style="font-size: 0.85rem; font-weight: 700; color: var(--navy-800); display: block; margin-bottom: 6px;">
            Pilih Profil Driver Bertugas:
          </label>
          <select id="driverSelect" class="form-control" onchange="window.location.href='/driver?id=' + this.value" style="font-weight: 700; font-size: 0.95rem;">
            ${drivers.map(d => '<option value="' + d.id + '" ' + (selectedDriver.id === d.id ? 'selected' : '') + '>' + d.name + ' (' + d.phone + ') - ' + d.car + '</option>').join('')}
          </select>
        </div>

        <!-- Big GPS Activation Button -->
        <div style="text-align: center; padding: 1rem; background: #f8fafc; border-radius: 12px; border: 1.5px solid #e2e8f0; margin-bottom: 1rem;">
          
          <div id="gpsStatusBadge" style="display: inline-flex; align-items: center; gap: 8px; padding: 6px 16px; border-radius: 25px; font-size: 0.85rem; font-weight: 800; margin-bottom: 1rem; background: ${selectedDriver.is_tracking_active ? '#dcfce7; color: #166534;' : '#fee2e2; color: #991b1b;'}">
            <span style="width: 10px; height: 10px; border-radius: 50%; background: ${selectedDriver.is_tracking_active ? '#22c55e' : '#ef4444'};"></span>
            <span id="gpsStatusText">${selectedDriver.is_tracking_active ? 'GPS AKTIF (SEDANG MEMBAGIKAN LOKASI)' : 'GPS OFFLINE / STANDBY'}</span>
          </div>

          <div>
            <button id="btnToggleGps" onclick="toggleGpsTracking()" class="btn btn-lg" style="width: 100%; max-width: 380px; padding: 14px 20px; font-size: 1rem; font-weight: 800; border-radius: 30px; background: ${selectedDriver.is_tracking_active ? '#ef4444' : '#16a34a'}; color: white; box-shadow: 0 4px 14px rgba(0,0,0,0.15);">
              ${selectedDriver.is_tracking_active ? '🔴 MATIKAN GPS (Selesai Perjalanan)' : '🟢 AKTIFKAN GPS SAYA (Mulai Perjalanan)'}
            </button>
          </div>

          <p id="gpsHelpText" style="font-size: 0.78rem; color: var(--gray-600); margin-top: 10px; margin-bottom: 0;">
            ${selectedDriver.is_tracking_active ? '✅ Lokasi Anda sedang disiarkan ke pelanggan secara real-time.' : 'Tekan tombol di atas & izinkan akses lokasi (GPS) di browser HP Anda.'}
          </p>
        </div>

        <!-- Telemetry Info from HP -->
        <div style="background: var(--navy-950); color: white; border-radius: 10px; padding: 1rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; font-size: 0.82rem;">
          <div>
            <span style="color: rgba(255,255,255,0.6); display: block; font-size: 0.72rem;">Latitude & Longitude:</span>
            <strong id="liveCoords" style="color: var(--gold-400); font-family: monospace;">${selectedDriver.current_lat || -7.6536}, ${selectedDriver.current_lng || 112.6917}</strong>
          </div>
          <div>
            <span style="color: rgba(255,255,255,0.6); display: block; font-size: 0.72rem;">Kecepatan Terkini:</span>
            <strong id="liveSpeed" style="color: #4ade80;">${selectedDriver.speed || 0} km/jam</strong>
          </div>
          <div>
            <span style="color: rgba(255,255,255,0.6); display: block; font-size: 0.72rem;">Akurasi Sinyal GPS:</span>
            <strong id="liveAccuracy" style="color: white;">${selectedDriver.accuracy ? selectedDriver.accuracy + ' meter' : 'Terkoneksi'}</strong>
          </div>
          <div>
            <span style="color: rgba(255,255,255,0.6); display: block; font-size: 0.72rem;">Terakhir Diperbarui:</span>
            <strong id="liveTime" style="color: var(--gold-300);">Real-time</strong>
          </div>
        </div>

      </div>

      <!-- Active Bookings Assigned to Driver -->
      <div class="card" style="padding: 1.25rem; border-radius: var(--radius-lg);">
        <h3 style="font-size: 1rem; color: var(--navy-900); margin-bottom: 0.85rem; display: flex; align-items: center; gap: 6px;">
          📋 Daftar Penumpang / Trip Aktif (${activeBookings.length})
        </h3>

        ${activeBookings.length === 0 ? '<p style="color: var(--gray-500); font-size: 0.85rem; text-align: center; padding: 1rem 0;">Belum ada jadwal penjemputan aktif.</p>' : ''}

        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          ${activeBookings.map(b => `
            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 0.85rem; font-size: 0.82rem;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                <strong style="color: var(--navy-900); font-family: monospace; font-size: 0.88rem;">${b.booking_code}</strong>
                <span style="background: #e2e8f0; padding: 2px 6px; border-radius: 4px; font-size: 0.72rem; font-weight: 600;">📅 ${b.travel_date}</span>
              </div>
              <div style="font-weight: 700; color: var(--navy-950); margin-bottom: 2px;">
                👤 ${b.passenger_name} (${b.passenger_count} Orang)
              </div>
              <div style="color: var(--gray-700); margin-bottom: 4px;">
                📍 <strong>Jemput:</strong> ${b.pickup_address} ${b.pickup_zone === 'kabupaten' ? '<span style="color: #b45309; font-weight: 700;">[Kabupaten]</span>' : ''}
              </div>
              <div style="color: var(--gray-700); margin-bottom: 6px;">
                🏁 <strong>Tujuan:</strong> ${b.dropoff_address}
              </div>
              <div style="display: flex; gap: 6px; align-items: center;">
                <a href="https://wa.me/62${b.passenger_phone.replace(/^0/, '').replace(/[^0-9]/g, '')}?text=${encodeURIComponent('Halo Kak ' + b.passenger_name + ', saya ' + selectedDriver.name + ' dari DH Trans yang bertugas menjemput Anda hari ini.')}" target="_blank" class="btn-wa-pill" style="padding: 5px 12px; font-size: 0.76rem; width: auto;">
                  💬 Chat WhatsApp Penumpang
                </a>
              </div>
            </div>
          `).join('')}
        </div>
      </div>

    </div>
  </section>

  <script>
    const driverId = ${selectedDriver.id};
    let isTracking = ${selectedDriver.is_tracking_active ? 'true' : 'false'};
    let watchId = null;
    let intervalHeartbeat = null;

    async function toggleGpsTracking() {
      if (!isTracking) {
        // Start GPS
        if (!navigator.geolocation) {
          alert('Perangkat/Browser HP Anda tidak mendukung GPS Geolocation.');
          return;
        }

        const btn = document.getElementById('btnToggleGps');
        btn.disabled = true;
        btn.innerHTML = '⏳ Mengaktifkan GPS...';

        navigator.geolocation.getCurrentPosition(
          async (pos) => {
            await sendLocationToServer(pos.coords.latitude, pos.coords.longitude, pos.coords.speed, pos.coords.accuracy, pos.coords.heading, true);
            
            // Watch continuous movements
            watchId = navigator.geolocation.watchPosition(
              (p) => {
                sendLocationToServer(p.coords.latitude, p.coords.longitude, p.coords.speed, p.coords.accuracy, p.coords.heading, true);
              },
              (err) => console.warn('Watch error:', err),
              { enableHighAccuracy: true, maximumAge: 3000, timeout: 10000 }
            );

            isTracking = true;
            updateUiState(true);
            btn.disabled = false;
          },
          (err) => {
            alert('Gagal mengakses GPS: ' + err.message + '. Pastikan izin Lokasi (GPS) diaktifkan di HP Anda.');
            btn.disabled = false;
            updateUiState(false);
          },
          { enableHighAccuracy: true, timeout: 10000 }
        );

      } else {
        // Stop GPS
        if (watchId) {
          navigator.geolocation.clearWatch(watchId);
          watchId = null;
        }

        try {
          await fetch('/api/driver/toggle-gps', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ driver_id: driverId, is_tracking_active: 0 })
          });
        } catch (e) {
          console.error(e);
        }

        isTracking = false;
        updateUiState(false);
      }
    }

    async function sendLocationToServer(lat, lng, speed, accuracy, heading, isActive) {
      document.getElementById('liveCoords').textContent = lat.toFixed(5) + ', ' + lng.toFixed(5);
      const kmh = speed ? Math.round(speed * 3.6) : 0;
      document.getElementById('liveSpeed').textContent = kmh + ' km/jam';
      document.getElementById('liveAccuracy').textContent = Math.round(accuracy || 0) + ' meter';
      document.getElementById('liveTime').textContent = new Date().toLocaleTimeString('id-ID');

      try {
        await fetch('/api/driver/location', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            driver_id: driverId,
            lat,
            lng,
            speed: kmh,
            accuracy: Math.round(accuracy || 0),
            heading: heading || 0,
            location_name: 'Live HP Driver (' + lat.toFixed(4) + ', ' + lng.toFixed(4) + ')'
          })
        });
      } catch (err) {
        console.error('Failed to send GPS data:', err);
      }
    }

    function updateUiState(active) {
      const badge = document.getElementById('gpsStatusBadge');
      const text = document.getElementById('gpsStatusText');
      const btn = document.getElementById('btnToggleGps');
      const help = document.getElementById('gpsHelpText');

      if (active) {
        badge.style.background = '#dcfce7';
        badge.style.color = '#166534';
        badge.querySelector('span').style.background = '#22c55e';
        text.textContent = 'GPS AKTIF (SEDANG MEMBAGIKAN LOKASI)';
        btn.style.background = '#ef4444';
        btn.innerHTML = '🔴 MATIKAN GPS (Selesai Perjalanan)';
        help.textContent = '✅ Lokasi Anda sedang disiarkan ke pelanggan secara real-time.';
      } else {
        badge.style.background = '#fee2e2';
        badge.style.color = '#991b1b';
        badge.querySelector('span').style.background = '#ef4444';
        text.textContent = 'GPS OFFLINE / STANDBY';
        btn.style.background = '#16a34a';
        btn.innerHTML = '🟢 AKTIFKAN GPS SAYA (Mulai Perjalanan)';
        help.textContent = 'Tekan tombol di atas & izinkan akses lokasi (GPS) di browser HP Anda.';
      }
    }
  </script>

` }) %>
